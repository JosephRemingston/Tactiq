{
  "name": "tactiq-api",
  "version": "1.0.0",
  "description": "Tactiq football tactical intelligence API (Express)",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start-server": "node index.js",
    "start-worker": "node worker.js",
    "dev": "node --watch index.js",
    "start": "node index.js",
    "cli": "node cli.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node cli.js db:migrate",
    "db:seed": "node cli.js db:seed",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"node_modules/**\" \"tests/*.test.js\"",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:secrets": "docker run --rm -v \"$PWD\":/repo ghcr.io/gitleaks/gitleaks:v8.30.1 git /repo --config /repo/.gitleaks.toml --redact --no-banner",
    "security:sast": "docker run --rm -v \"$PWD\":/src -w /src semgrep/semgrep:1.184.0 semgrep scan --metrics=off --error --severity ERROR --config p/javascript --config p/nodejsscan --config p/expressjs --config p/owasp-top-ten --config p/jwt --config p/secrets"
  },
  "dependencies": {
    "@clerk/backend": "^3.27.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.41.0",
    "aws4fetch": "^1.0.20",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "pg": "^8.23.1",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
