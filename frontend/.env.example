# Publishable key of the Clerk instance the backend verifies against (pk_test_... or pk_live_...).
VITE_CLERK_PUBLISHABLE_KEY=
# Leave empty when the API is served from the same origin (Netlify). Otherwise e.g. https://api.example.com
VITE_API_BASE_URL=
# Local development only: where `pnpm dev` proxies /v1 requests.
API_PROXY_TARGET=http://localhost:3000
