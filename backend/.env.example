# Copy to .env for local development. Every variable is validated in src/config/env.ts.
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info
ENABLE_SWAGGER=true

# Neon: copy the connection string from the Neon console (sslmode=require). Local Docker: see .env.docker
DATABASE_URL=postgres://touchline:touchline@localhost:5432/touchline
# Upstash and other managed Redis need TLS: use rediss://
REDIS_URL=redis://localhost:6380

# Object storage: Neon Object Storage (S3-compatible, branches with your Neon database).
#   1. neon buckets create touchline-raw
#   2. neon env pull            (writes the four AWS_* values below for your branch)
#   3. pnpm cli storage:check   (writes and reads back a test object)
STORAGE_DRIVER=neon
S3_BUCKET_RAW=touchline-raw
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Clerk (https://dashboard.clerk.com > API keys). Development keys start sk_test_/pk_test_; a production
# instance uses sk_live_/pk_live_ and has its own JWT public key and webhook secret.
#   CLERK_JWT_KEY             PEM public key (API keys > Show JWT public key) for networkless verification
#   CLERK_AUTHORIZED_PARTIES  comma-separated web origins allowed in the token's azp claim (native app tokens may omit azp)
#   CLERK_WEBHOOK_SIGNING_SECRET  from Webhooks > endpoint https://<api-host>/v1/webhooks/clerk (user.created/updated/deleted)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=
CLERK_WEBHOOK_SIGNING_SECRET=

# StatsBomb Open Data: non-commercial use only, attribution required.
STATSBOMB_SOURCE=github
STATSBOMB_OPEN_DATA_BASE_URL=https://raw.githubusercontent.com/statsbomb/open-data/master/data
STATSBOMB_OPEN_DATA_LOCAL_DIR=
STATSBOMB_COMPETITION_ALLOWLIST=43:106,43:3
STATSBOMB_RATE_PER_SECOND=2
STATSBOMB_USER_AGENT=Touchline-dev/0.1
SPORTMONKS_API_TOKEN=

# Keep provider event JSON in Postgres as well (off: raw payloads already live in object storage).
EVENTS_STORE_RAW=false
# On per-command-billed Redis such as Upstash, raise these to cut idle polling (e.g. 30 and 120000).
WORKER_DRAIN_DELAY_SECONDS=5
WORKER_STALLED_INTERVAL_MS=30000
WORKER_QUEUES=provider-sync,match-ingestion,normalization,tactical-analytics
WORKER_CONCURRENCY_INGESTION=2
WORKER_CONCURRENCY_ANALYTICS=2

THROTTLE_IP_PER_MIN=120
THROTTLE_USER_PER_MIN=600
CACHE_TTL_MATCH_SECONDS=60
