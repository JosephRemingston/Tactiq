# Local Docker Compose services. Source before commands to override .env without editing it:
#   set -a; source .env.docker; set +a; pnpm db:migrate
DATABASE_URL=postgres://touchline:touchline@localhost:5432/touchline
REDIS_URL=redis://localhost:6380
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.data/storage
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
