{
  "name": "touchline-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Touchline football tactical intelligence backend (NestJS API + BullMQ workers)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/db/migrations dist/db/",
    "dev:api": "node --watch -r @swc-node/register src/main.ts",
    "dev:worker": "node --watch -r @swc-node/register src/worker.ts",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "cli": "node -r @swc-node/register src/cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node -r @swc-node/register src/db/migrate.ts",
    "db:seed": "node -r @swc-node/register src/db/seed/index.ts",
    "fixtures:download": "tsx scripts/fetch-fixtures.ts",
    "openapi:export": "node -r @swc-node/register scripts/export-openapi.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration test/e2e",
    "db:migrate:prod": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1166.0",
    "@clerk/backend": "3.27.0",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "bullmq": "6.7.4",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "rate-limiter-flexible": "11.4.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "serverless-http": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.2",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.22",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/aws-lambda": "8.10.164",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.0",
    "supertest": "7.3.2",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "cpu-features",
      "ssh2",
      "protobufjs"
    ]
  }
}
