# Tactiq backend configuration. Copy to .env for local runs.
# On Netlify and GitHub Actions these are set as environment variables / secrets instead.

NODE_ENV=development
PORT=3000

# Neon Postgres (pooled connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_MAX=3

# Upstash Redis. Only the rediss:// URL is needed: the app talks to Upstash over HTTPS using the same host and password.
# Optional: without it caching and rate limits are off.
REDIS_URL=rediss://default:password@your-db.upstash.io:6379

# Object storage for raw provider payloads (Neon Object Storage, S3-compatible). fs = local disk.
STORAGE_DRIVER=neon
S3_ENDPOINT=https://br-xxxx.storage.region.aws.neon.tech
S3_BUCKET_RAW=tactiq
S3_REGION_OVERRIDE=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Clerk
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...
# PEM public key (Clerk dashboard > API keys > JWT public key): verifies tokens without a network call.
CLERK_JWT_KEY=
# Comma-separated origins allowed in the token's azp claim. Leave empty for a native-only app.
CLERK_AUTHORIZED_PARTIES=
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Football data
STATSBOMB_SOURCE=github
STATSBOMB_COMPETITION_ALLOWLIST=43:106,43:3

# Google Play Billing (billing endpoints answer 503 until these are set)
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Shared token in the Pub/Sub push URL: https://<api>/v1/webhooks/google-play-rtdn?token=<value>
GOOGLE_PLAY_RTDN_TOKEN=
# Local development only: accept fake purchase tokens (fake:pro_monthly:active:30). Ignored in production.
BILLING_FAKE_VERIFIER=false

# AdMob ad units. Outside production Google's public test units are used when empty.
ADMOB_NATIVE_UNIT_ID=
ADMOB_BANNER_UNIT_ID=

# Security
# Comma-separated browser origins for CORS. The Android app needs none.
CORS_ORIGINS=
THROTTLE_IP_PER_MIN=120
THROTTLE_USER_PER_MIN=600
# Per-IP backstop for every request, counted in memory per instance (covers webhooks, health checks, forged headers).
THROTTLE_IP_BACKSTOP_PER_MIN=1200
# Only if a proxy you control sits in front and sets X-Forwarded-For: the number of proxy hops to trust.
# Leave empty on Netlify (the client IP comes from x-nf-client-connection-ip) and behind Cloudflare (CF-Connecting-IP).
TRUST_PROXY=
# Set when Cloudflare (or another proxy) is put in front: requests without x-edge-secret are rejected.
EDGE_SHARED_SECRET=
